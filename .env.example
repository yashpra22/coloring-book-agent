# Environment Variables - Copy to .env and fill in your keys

# OpenRouter (for LLM prompt generation)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Cloudflare Workers AI (PRIMARY image generation - free 10k neurons/day)
# Get Account ID + API Token at: https://dash.cloudflare/?to=/:account/ai
# Token needs "Workers AI Read" + "Workers AI Edit" permissions
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here

# NVIDIA NIM (fallback image generation - needs SDXL function enabled)
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-key-here

# Hugging Face (fallback image generation - Inference Providers)
# Get your token at: https://huggingface.co/settings/tokens (needs "Inference Providers" permission)
HF_TOKEN=hf_your-huggingface-token-here
